<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 13 and up require this before any notification can be posted, including the ongoing
      timer notification that stands in for iOS's Live Activity. It is requested at first launch
      from MainActivity, not from a receiver.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Reminders are concrete one-off alarms so a fired reminder can quote today's numbers, which
      needs exact delivery. ReminderScheduler falls back to an inexact alarm when the user has not
      granted this, so the app still works without it — which is why SCHEDULE_EXACT_ALARM is
      declared and USE_EXACT_ALARM deliberately is not (that one is reserved for apps whose whole
      purpose is alarms).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- The armed-alarm set is rebuilt after a reboot, since the system drops alarms with it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".HabitsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Habits">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Habits"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Reminder alarms. Each receiver is matched by the intent action the scheduler armed it
          with, and none of them is exported: they exist to be woken by this app's own PendingIntents
          and by AlarmManager, not by anything else on the device.
        -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sahilchanna.habits.HABIT_REMINDER" />
                <action android:name="com.sahilchanna.habits.WATER_REMINDER" />
                <action android:name="com.sahilchanna.habits.REMINDER_TEST" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sahilchanna.habits.HABIT_DONE" />
                <action android:name="com.sahilchanna.habits.WATER_LOG_GLASS" />
                <action android:name="com.sahilchanna.habits.SNOOZE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.TimerActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sahilchanna.habits.TIMER_DONE" />
                <action android:name="com.sahilchanna.habits.TIMER_PAUSE" />
                <action android:name="com.sahilchanna.habits.TIMER_DISCARD" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The two home-screen widget sizes. -->
        <receiver
            android:name=".widgets.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.TodaySmallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_small_widget_info" />
        </receiver>
    </application>

</manifest>
